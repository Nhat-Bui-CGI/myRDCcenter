import { Button, LineEdit, CheckBox, SpinBox, ScrollView, TextEdit, ComboBox, Palette, HorizontalBox, VerticalBox } from "std-widgets.slint";

export struct ConnData {
    id: string,
    name: string,
    group: string,
    host: string,
    port: int,
    username: string,
    domain: string,
    password: string,
    gateway: string,
    fullscreen: bool,
    width: int,
    height: int,
    multimon: bool,
    redirect-clipboard: bool,
    redirect-drives: bool,
    admin-session: bool,
    notes: string,
}

export struct ListRow {
    id: string,         // connection id; empty for a group row
    group-path: string, // group path; empty for a connection row
    title: string,
    tooltip: string,
    depth: int,
    expanded: bool,
}

component Field inherits HorizontalLayout {
    in property <string> label;
    spacing: 12px;
    Text {
        text: root.label;
        width: 120px;
        vertical-alignment: center;
    }
    @children
}

component LockScreen inherits Rectangle {
    in property <bool> creating;
    in property <string> error;
    in property <string> vault-path;
    in property <bool> remember-supported;
    in property <string> remember-label;
    in property <bool> has-remembered;
    callback submit(string, string, bool);
    callback unlock-remembered();
    property <string> confirm;
    property <bool> remember;

    function do-submit() {
        root.submit(pw.text, root.confirm, root.remember);
        pw.text = "";
        root.confirm = "";
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                width: 320px;
                spacing: 10px;
                Text { text: "myRDCcenter"; font-size: 28px; horizontal-alignment: center; }
                Text {
                    text: root.creating ? "Create a master password. It encrypts your vault and can't be recovered." : "Enter your master password to unlock.";
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }
                pw := LineEdit {
                    input-type: password;
                    placeholder-text: "Master password";
                    accepted => { root.do-submit(); }
                }
                if root.creating: LineEdit {
                    input-type: password;
                    placeholder-text: "Repeat password";
                    text <=> root.confirm;
                    accepted => { root.do-submit(); }
                }
                if root.remember-supported: CheckBox {
                    text: root.remember-label;
                    checked <=> root.remember;
                }
                Button {
                    text: root.creating ? "Create vault" : "Unlock";
                    primary: true;
                    clicked => { root.do-submit(); }
                }
                if root.has-remembered && !root.creating: Button {
                    text: "Unlock with my computer login";
                    clicked => { root.unlock-remembered(); }
                }
                Text { text: root.error; color: #ff7070; horizontal-alignment: center; height: 20px; }
                Text { text: root.vault-path; font-size: 11px; color: Palette.foreground.with-alpha(0.5); horizontal-alignment: center; wrap: word-wrap; }
            }
        }
    }
    init => { pw.focus(); }
}

export component MainWindow inherits Window {
    title: "myRDCcenter";
    icon: @image-url("../../assets/icon-256.png");
    preferred-width: 1000px;
    preferred-height: 720px;
    min-width: 720px;
    in-out property <length> sidebar-width: 290px;
    min-height: 440px;

    in property <bool> locked: true;
    in property <bool> creating;
    in property <string> lock-error;
    in property <string> vault-path;
    in property <[ListRow]> rows;
    in property <string> selected-id;
    in property <bool> has-draft;
    in-out property <ConnData> draft;
    in property <string> status;
    in-out property <string> search;
    in-out property <int> auto-lock-minutes;
    in-out property <bool> show-password;
    in-out property <bool> confirm-delete;
    in-out property <bool> change-pw-open;
    // Groups
    in property <[string]> group-names;      // for the Group picker; first entry is "(no group)"
    in property <string> selected-group;     // path of the selected group row
    in property <string> group-count-text;
    in-out property <bool> confirm-delete-group;
    in-out property <bool> group-dialog-open;
    in property <string> group-dialog-title;
    in property <string> group-dialog-hint;
    in-out property <string> group-dialog-name;
    in property <string> group-dialog-error;

    callback unlock(string, string, bool);
    callback unlock-remembered();
    callback set-remember(bool);
    in property <bool> remember-supported;
    in property <string> remember-label;
    in property <bool> has-remembered;
    in-out property <bool> remembered;
    callback search-changed(string);
    callback select(string);
    callback activate(string);
    callback new-connection();
    callback import-rdp();
    callback backup();
    callback save();
    callback connect();
    callback delete();
    callback lock();
    callback auto-lock-changed(int);
    callback change-password(string, string);
    callback click-group(string);
    callback toggle-group(string);
    callback new-group();
    callback new-connection-here();
    callback rename-group();
    callback delete-group();
    callback group-dialog-ok(string);
    // Export / import of .rdcx files
    in-out property <bool> export-open;
    in property <[string]> export-scopes;     // "All connections", then group paths
    in-out property <string> export-scope;
    in property <string> export-count-text;
    in property <string> export-error;
    in-out property <bool> export-move;
    in-out property <bool> import-pw-open;
    in property <string> import-pw-error;
    callback export-request(string);          // "" = all, or a group path
    callback export-scope-changed(string);
    callback export-ok(string, string);
    callback import-pw-ok(string);

    if root.locked: LockScreen {
        creating: root.creating;
        error: root.lock-error;
        vault-path: root.vault-path;
        remember-supported: root.remember-supported;
        remember-label: root.remember-label;
        has-remembered: root.has-remembered;
        submit(a, b, r) => { root.unlock(a, b, r); }
        unlock-remembered => { root.unlock-remembered(); }
    }

    if !root.locked: VerticalLayout {
        // Toolbar
        HorizontalBox {
            Button { text: "New connection"; clicked => { root.new-connection(); } }
            Button { text: "New group"; clicked => { root.new-group(); } }
            Button { text: "Import"; clicked => { root.import-rdp(); } }
            Button { text: "Export"; clicked => { root.export-request(""); } }
            Button { text: "Backup"; clicked => { root.backup(); } }
            Button { text: "Change password"; clicked => { root.change-pw-open = true; } }
            if root.remember-supported: CheckBox {
                text: "Remember on this computer";
                checked <=> root.remembered;
                toggled => { root.set-remember(self.checked); }
            }
            Text { text: "Auto-lock (min):"; vertical-alignment: center; }
            SpinBox {
                width: 90px;
                minimum: 0;
                maximum: 240;
                value <=> root.auto-lock-minutes;
                edited(v) => { root.auto-lock-changed(v); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "Lock"; clicked => { root.lock(); } }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            // Connection list
            VerticalBox {
                width: root.sidebar-width;
                LineEdit {
                    placeholder-text: "Search";
                    text <=> root.search;
                    edited(t) => { root.search-changed(t); }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        for row in root.rows: Rectangle {
                            property <bool> is-group: row.id == "";
                            property <bool> selected: is-group ? row.group-path == root.selected-group : row.id == root.selected-id;
                            height: 26px;
                            border-radius: 4px;
                            background: selected ? Palette.selection-background : (ta.has-hover ? Palette.alternate-background : transparent);
                            ta := TouchArea {
                                clicked => {
                                    if (is-group) { root.click-group(row.group-path); } else { root.select(row.id); }
                                }
                                double-clicked => {
                                    if (!is-group) { root.activate(row.id); }
                                }
                            }
                            // Expand / collapse arrow for groups
                            if is-group: Rectangle {
                                x: row.depth * 16px + 2px;
                                width: 16px;
                                height: parent.height;
                                Path {
                                    width: 10px;
                                    height: 10px;
                                    viewbox-width: 10;
                                    viewbox-height: 10;
                                    commands: row.expanded ? "M 1 3 L 9 3 L 5 8 Z" : "M 3 1 L 8 5 L 3 9 Z";
                                    fill: selected ? Palette.selection-foreground : Palette.foreground;
                                }
                                TouchArea { clicked => { root.toggle-group(row.group-path); } }
                            }
                            Text {
                                x: row.depth * 16px + 22px;
                                text: row.title;
                                font-weight: is-group ? 700 : 400;
                                vertical-alignment: center;
                                color: selected ? Palette.selection-foreground : Palette.foreground;
                                overflow: elide;
                                width: parent.width - self.x - 4px;
                            }
                        }
                        if root.rows.length == 0: Text {
                            text: root.search == "" ? "No connections yet. Click New connection." : "Nothing found.";
                            color: Palette.foreground.with-alpha(0.5);
                        }
                    }
                }
            }
            // Drag to resize the connection list
            Rectangle {
                width: 7px;
                Rectangle { width: 1px; background: splitter.has-hover || splitter.pressed ? Palette.accent-background : Palette.border; }
                splitter := TouchArea {
                    mouse-cursor: ew-resize;
                    moved => {
                        if (self.pressed) {
                            root.sidebar-width = clamp(root.sidebar-width + self.mouse-x - self.pressed-x, 180px, root.width - 540px);
                        }
                    }
                }
            }

            // Details
            if !root.has-draft && root.selected-group != "": VerticalBox {
                horizontal-stretch: 1;
                alignment: start;
                Text { text: root.selected-group; font-size: 20px; overflow: elide; }
                Text { text: root.group-count-text; color: Palette.foreground.with-alpha(0.7); }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "New connection here"; clicked => { root.new-connection-here(); } }
                    Button { text: "New subgroup"; clicked => { root.new-group(); } }
                    Button { text: "Rename / move"; clicked => { root.rename-group(); } }
                    Button { text: "Export group"; clicked => { root.export-request(root.selected-group); } }
                    if !root.confirm-delete-group: Button { text: "Delete group"; clicked => { root.confirm-delete-group = true; } }
                    if root.confirm-delete-group: Button { text: "Really delete group?"; clicked => { root.delete-group(); } }
                    if root.confirm-delete-group: Button { text: "Cancel"; clicked => { root.confirm-delete-group = false; } }
                }
                if root.confirm-delete-group: Text {
                    text: "Connections in this group are kept and move up one level.";
                    color: Palette.foreground.with-alpha(0.6);
                }
            }
            if !root.has-draft && root.selected-group == "": Text {
                horizontal-stretch: 1;
                text: "Select a connection, or double-click to connect";
                horizontal-alignment: center;
                vertical-alignment: center;
                color: Palette.foreground.with-alpha(0.5);
            }
            if root.has-draft: VerticalLayout {
                horizontal-stretch: 1;
                // Title and actions stay visible; only the form scrolls.
                HorizontalBox {
                    Text {
                        text: root.draft.name == "" ? root.draft.host : root.draft.name;
                        font-size: 20px;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    Button { text: "Connect"; primary: true; clicked => { root.connect(); } }
                    Button { text: "Save"; clicked => { root.save(); } }
                    if !root.confirm-delete: Button { text: "Delete"; clicked => { root.confirm-delete = true; } }
                    if root.confirm-delete: Button { text: "Really delete?"; clicked => { root.delete(); } }
                    if root.confirm-delete: Button { text: "Cancel"; clicked => { root.confirm-delete = false; } }
                }
                ScrollView {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: start;
                        VerticalBox {
                            alignment: start;
                            spacing: 8px;
                            width: min(640px, root.width - root.sidebar-width - 20px);
                            Field { label: "Name"; LineEdit { text <=> root.draft.name; } }
                            Field { label: "Group"; ComboBox { model: root.group-names; current-value <=> root.draft.group; } }
                            Field { label: "Host"; LineEdit { text <=> root.draft.host; } }
                            Field { label: "Port"; SpinBox { width: 140px; minimum: 1; maximum: 65535; value <=> root.draft.port; } Rectangle {} }
                            Field { label: "Username"; LineEdit { text <=> root.draft.username; } }
                            Field { label: "Domain"; LineEdit { text <=> root.draft.domain; } }
                            Field {
                                label: "Password";
                                LineEdit { text <=> root.draft.password; input-type: root.show-password ? text : password; }
                                Button { text: root.show-password ? "Hide" : "Show"; clicked => { root.show-password = !root.show-password; } }
                            }
                            Field { label: "RD Gateway"; LineEdit { text <=> root.draft.gateway; } }
                            Field {
                                label: "Screen";
                                CheckBox { text: "Full screen"; checked <=> root.draft.fullscreen; }
                                SpinBox { width: 120px; enabled: !root.draft.fullscreen; minimum: 640; maximum: 7680; value <=> root.draft.width; }
                                Text { text: "x"; vertical-alignment: center; }
                                SpinBox { width: 120px; enabled: !root.draft.fullscreen; minimum: 480; maximum: 4320; value <=> root.draft.height; }
                                Rectangle {}
                            }
                            Field {
                                label: "Options";
                                VerticalLayout {
                                    spacing: 4px;
                                    CheckBox { text: "Use all monitors"; checked <=> root.draft.multimon; }
                                    CheckBox { text: "Share clipboard"; checked <=> root.draft.redirect-clipboard; }
                                    CheckBox { text: "Share local drives"; checked <=> root.draft.redirect-drives; }
                                    CheckBox { text: "Admin / console session"; checked <=> root.draft.admin-session; }
                                }
                            }
                            Field { label: "Notes"; TextEdit { text <=> root.draft.notes; height: 80px; } }
                        }
                    }
                }
            }
        }

        // Status bar
        Rectangle {
            height: 24px;
            Text {
                x: 8px;
                text: root.status;
                color: Palette.foreground.with-alpha(0.6);
                vertical-alignment: center;
                overflow: elide;
                width: parent.width - 16px;
            }
        }
    }

    // Change-password dialog
    if root.change-pw-open && !root.locked: Rectangle {
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: 340px;
            height: 200px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalBox {
                Text { text: "Change master password"; font-size: 16px; }
                np := LineEdit { input-type: password; placeholder-text: "New password"; }
                np2 := LineEdit { input-type: password; placeholder-text: "Repeat"; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Change"; primary: true; clicked => { root.change-password(np.text, np2.text); np.text = ""; np2.text = ""; } }
                    Button { text: "Cancel"; clicked => { root.change-pw-open = false; np.text = ""; np2.text = ""; } }
                }
            }
        }
    }

    // New / rename group dialog
    if root.group-dialog-open && !root.locked: Rectangle {
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: 360px;
            height: 210px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalBox {
                Text { text: root.group-dialog-title; font-size: 16px; }
                Text { text: root.group-dialog-hint; color: Palette.foreground.with-alpha(0.6); }
                gn := LineEdit {
                    placeholder-text: "Group name";
                    text <=> root.group-dialog-name;
                    accepted => { root.group-dialog-ok(self.text); }
                    init => { self.focus(); }
                }
                Text { text: root.group-dialog-error; color: #ff7070; height: 18px; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "OK"; primary: true; clicked => { root.group-dialog-ok(gn.text); } }
                    Button { text: "Cancel"; clicked => { root.group-dialog-open = false; } }
                }
            }
        }
    }

    // Export dialog
    if root.export-open && !root.locked: Rectangle {
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: 420px;
            height: 360px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalBox {
                Text { text: "Export connections"; font-size: 16px; }
                Text {
                    text: "Makes an encrypted .rdcx file with connections and passwords. Open it on the other computer with Import.";
                    wrap: word-wrap;
                    color: Palette.foreground.with-alpha(0.7);
                }
                ComboBox {
                    model: root.export-scopes;
                    current-value <=> root.export-scope;
                    selected(v) => { root.export-scope-changed(v); }
                }
                Text { text: root.export-count-text; color: Palette.foreground.with-alpha(0.6); }
                ep := LineEdit { input-type: password; placeholder-text: "Password for the file"; }
                ep2 := LineEdit { input-type: password; placeholder-text: "Repeat password"; }
                CheckBox { text: "Move: remove them from this computer after exporting"; checked <=> root.export-move; }
                Text { text: root.export-error; color: #ff7070; height: 18px; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Export..."; primary: true; clicked => { root.export-ok(ep.text, ep2.text); } }
                    Button { text: "Cancel"; clicked => { root.export-open = false; ep.text = ""; ep2.text = ""; } }
                }
            }
        }
    }

    // Password for importing an .rdcx file
    if root.import-pw-open && !root.locked: Rectangle {
        background: #00000080;
        TouchArea {}
        Rectangle {
            width: 360px;
            height: 200px;
            background: Palette.background;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.border;
            VerticalBox {
                Text { text: "Import export file"; font-size: 16px; }
                Text { text: "Enter the password chosen when the file was exported."; wrap: word-wrap; color: Palette.foreground.with-alpha(0.7); }
                ip := LineEdit {
                    input-type: password;
                    placeholder-text: "Export password";
                    accepted => { root.import-pw-ok(self.text); }
                    init => { self.focus(); }
                }
                Text { text: root.import-pw-error; color: #ff7070; height: 18px; }
                HorizontalLayout {
                    spacing: 8px;
                    Button { text: "Import"; primary: true; clicked => { root.import-pw-ok(ip.text); } }
                    Button { text: "Cancel"; clicked => { root.import-pw-open = false; } }
                }
            }
        }
    }
}
